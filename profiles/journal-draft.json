{
  "version": 1,
  "settings": {
    "max_paragraph_chars": 450,
    "require_references": true
  },
  "disabled_rules": [],
  "severity_overrides": {
    "placeholder-text": "error",
    "missing-references": "error"
  },
  "pattern_rules": [
    {
      "id": "informal-first-person-opinion",
      "pattern": "我觉得|我感觉",
      "severity": "info",
      "message": "Potentially informal first-person opinion wording found.",
      "rationale": "Unqualified first-person opinion phrases may be too informal for some academic contexts.",
      "false_positives": [
        "Quoted interviews",
        "First-person qualitative research",
        "Linguistic analysis of the phrase"
      ]
    },
    {
      "id": "informal-intensifier",
      "pattern": "非常非常|超级",
      "severity": "info",
      "message": "Potentially informal intensifier found.",
      "rationale": "Colloquial intensifiers may weaken formal academic claims.",
      "false_positives": [
        "Quoted source material",
        "Linguistic analysis of colloquial wording"
      ]
    }
  ]
}
